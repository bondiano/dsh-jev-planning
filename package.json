{
  "name": "@local/dsh-jev-planning",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Staged planning through the Jev judge: requirements, outline, detail and final plan review, with a gate that holds consequential changes until the plan artifact's exact bytes are approved.",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./dist/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist/**/*.js",
    "!dist/test/",
    "index.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "README.md",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "xstate": "5.33.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bondiano/dsh-jev-planning.git"
  },
  "homepage": "https://github.com/bondiano/dsh-jev-planning#readme",
  "bugs": {
    "url": "https://github.com/bondiano/dsh-jev-planning/issues"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "typescript": "7.0.2"
  }
}
